NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INTERNAL_URL=

# Payment webhook signature verification (optional in dev)
MOMO_WEBHOOK_SECRET=
VNPAY_WEBHOOK_SECRET=

# --- Production deployment only (docker-compose.prod.yml) ---
# nginx config to mount: "http" before a TLS cert exists, "ssl" after.
# scripts/init-letsencrypt.sh flips this for you.
NGINX_MODE=http
# Address Let's Encrypt sends expiry notices to.
LETSENCRYPT_EMAIL=
